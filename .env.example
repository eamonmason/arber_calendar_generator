# Arbor Calendar Sync Environment Configuration
# Copy this file to .env and adjust the values as needed

# Google Calendar Configuration
# GOOGLE_CALENDAR_ID=primary                    # Google Calendar ID (defaults to "primary")
# GOOGLE_CREDENTIALS_PATH=                      # Path to Google OAuth credentials file
# GOOGLE_TOKEN_PATH=                            # Path to Google OAuth token file

# Arbor Configuration
# ARBOR_BASE_URL=https://your-school.uk.arbor.sc  # Base URL for your Arbor instance
# ARBOR_TIMEZONE=Europe/London                  # Timezone for Arbor events
# ARBOR_LOGIN_URL=                              # Custom login URL (auto-constructed from base URL if not set)
# ARBOR_CALENDAR_URL=                           # Custom calendar API URL (auto-constructed from base URL if not set)
# ARBOR_STUDENT_OBJECT_ID=7192                  # Student object ID for filtering calendar entries (optional)
# ARBOR_USERNAME=                               # Arbor username for automatic login (optional)
# ARBOR_PASSWORD=                               # Arbor password for automatic login (optional)

# Sync Behavior Configuration
# SYNC_DELETE_ORPHANED_EVENTS=true             # Delete calendar events that no longer exist in Arbor
# SYNC_UPDATE_EXISTING_EVENTS=true             # Update existing calendar events when they change in Arbor
# SYNC_BATCH_SIZE=100                           # Number of events to process in each batch
# SYNC_DRY_RUN=false                            # Run in dry-run mode (preview changes without applying them)

# Academic Year Configuration
# ACADEMIC_YEAR_START_MONTH=9                   # Academic year starts in September
# ACADEMIC_YEAR_START_DAY=1                     # Academic year starts on the 1st
# ACADEMIC_YEAR_END_MONTH=7                     # Academic year ends in July
# ACADEMIC_YEAR_END_DAY=31                      # Academic year ends on the 31st

# Security Note: Keep this file secure and do not commit it to version control
# Add .env to your .gitignore file to prevent accidental commits